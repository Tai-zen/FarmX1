rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.role == 'admin';
    }

    // User Profiles
    match /user_profiles/{uid} {
      allow read: if isSignedIn();

      allow create: if isOwner(uid)
        && request.resource.data.role in ['farmer', 'consumer'];

      allow update: if isOwner(uid)
        && request.resource.data.role in ['farmer', 'consumer'];

      allow delete: if false;

      allow read, write: if isAdmin();
    }

    // Products
    match /products/{productId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.farmerUid == request.auth.uid;

      allow update: if isSignedIn()
        && (
          resource.data.farmerUid == request.auth.uid ||
          isAdmin()
        );

      allow delete: if isSignedIn()
        && (
          resource.data.farmerUid == request.auth.uid ||
          isAdmin()
        );
    }

    // Orders
    match /orders/{orderId} {
      allow create: if isSignedIn()
        && request.resource.data.buyerUid == request.auth.uid;

      allow read: if isSignedIn()
        && (
          resource.data.buyerUid == request.auth.uid ||
          resource.data.farmerUid == request.auth.uid ||
          isAdmin()
        );

      allow update: if isSignedIn()
        && (
          (resource.data.farmerUid == request.auth.uid
            && request.resource.data.status == 'dispatched') ||

          (resource.data.buyerUid == request.auth.uid
            && request.resource.data.status == 'delivered') ||

          isAdmin()
        );

      allow delete: if false;
    }

    // Cart
    match /carts/{cartItemId} {
      allow read, write: if isSignedIn()
        && (
          resource == null
            ? request.resource.data.userId == request.auth.uid
            : resource.data.userId == request.auth.uid
        );
    }

    // Planting Calendars
    match /planting_calendars/{scheduleId} {
      allow read, write: if isSignedIn()
        && (
          resource == null
            ? request.resource.data.uid == request.auth.uid
            : resource.data.uid == request.auth.uid
        );
    }

    // User Actions (Audit Log)
    match /user_actions/{actionId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      allow read: if isAdmin();

      allow update, delete: if false;
    }

    // Admin-only collections
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}