rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Rule 1 of Fortress Rules)
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Reusable Global Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 2. Validation Blueprints (Rule 2 of Fortress Rules)
    function isValidUserProfile(data) {
      return data.uid is string 
        && data.uid.size() <= 128
        && data.uid == request.auth.uid
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 100
        && data.email is string
        && data.email.size() <= 128
        && data.role is string
        && (data.role == 'farmer' || data.role == 'consumer');
    }

    function isValidUserAction(data) {
      return data.id is string
        && data.id.size() <= 128
        && data.uid is string
        && data.uid == request.auth.uid
        && data.actionType is string
        && data.actionType.size() <= 100
        && data.description is string
        && data.description.size() <= 500;
    }

    // 4. Matches for Collections (Rule 11/12 of Fortress Rules)
    match /user_profiles/{uid} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isOwner(uid);
      allow create: if isSignedIn() && isOwner(uid) && isValidUserProfile(request.resource.data) 
                    && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn() && isOwner(uid) && isValidUserProfile(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false; // Profiles are permanent records
    }

    match /user_actions/{actionId} {
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && isOwner(request.resource.data.uid) && isValidUserAction(request.resource.data)
                    && request.resource.data.timestamp == request.time;
      allow update, delete: if false; // Action logs are append-only immutable audit trials
    }

    function isValidProduct(data) {
  return data.farmerUid == request.auth.uid
    && data.name is string && data.name.size() > 0
    && data.price is number && data.price >= 0
    && data.unit is string
    && data.category is string
    && data.status in ['in_stock','low_stock','out_of_stock','archived'];
}

match /products/{productId} {
  allow get, list: if true; // public marketplace read
  allow create: if isSignedIn() && isValidProduct(request.resource.data);
  allow update, delete: if isSignedIn() && resource.data.farmerUid == request.auth.uid;
}

function isValidOrder(data) {
  return data.buyerUid == request.auth.uid
    && data.farmerUid is string
    && data.amount is number && data.amount > 0
    && data.status in ['new','dispatched','delivered'];
}

match /orders/{orderId} {
  allow get: if isSignedIn() && (resource.data.buyerUid == request.auth.uid || resource.data.farmerUid == request.auth.uid);
  allow list: if isSignedIn();
  allow create: if isSignedIn() && isValidOrder(request.resource.data);
  allow update: if isSignedIn() && (resource.data.buyerUid == request.auth.uid || resource.data.farmerUid == request.auth.uid);
  allow delete: if false;
}

match /planting_calendars/{scheduleId} {
  allow get, list: if isSignedIn() && resource.data.uid == request.auth.uid;
  allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
  allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
}

  }
}
