# Supabase Configuration (Optional for real image uploads; falls back to SVG/blob previews)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_BUCKET=agrifarm-images

# Paystack Payment Gateway
# Secret Key is restricted to backend (never exposed to client)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
# Public Key used for frontend Inline JS checkout
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here

# Firebase Configuration
FIREBASE_API_KEY=
